{
  "name": "ruchi-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-static.jsx --outDir node_modules/.cache/portfolio-static --emptyOutDir && node scripts/prerender.mjs",
    "lint": "eslint src scripts tests vite.config.js playwright.config.js",
    "preview": "vite preview",
    "test": "node --test scripts/portfolio.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "motion": "^14.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  }
}
